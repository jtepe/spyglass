digraph run_store_schema {
    graph [
        label="Spyglass Run Store schema (version 1)"
        labelloc=t
        fontsize=20
        fontname="Helvetica"
        rankdir=LR
        nodesep=0.45
        ranksep=1.1
        splines=ortho
    ];
    node [shape=plain fontname="Helvetica"];
    edge [color="#64748b" arrowsize=0.8 fontname="Helvetica" fontsize=10];

    runs [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0f766e" COLSPAN="3"><FONT COLOR="white"><B>runs</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">generated_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">tenant_id</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">tool_version</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">selection_tag</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">selection_object_ids</TD><TD ALIGN="LEFT">TEXT NOT NULL (JSON)</TD></TR>
        </TABLE>
    >];

    run_errors [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>run_errors</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD PORT="run_id" ALIGN="LEFT"><B>run_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>position</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    service_principals [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0f766e" COLSPAN="3"><FONT COLOR="white"><B>service_principals</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK, UQ</B></TD><TD PORT="run_id" ALIGN="LEFT"><B>run_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT"><B>object_id</B></TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">app_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">tags</TD><TD ALIGN="LEFT">TEXT NOT NULL (JSON)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">application_present</TD><TD ALIGN="LEFT">INTEGER NOT NULL (0/1)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">application_object_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">application_app_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">application_display_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9">UNIQUE (run_id, object_id)</FONT></TD></TR>
        </TABLE>
    >];

    sp_sections [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>sp_sections</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>section</B></TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    sp_errors [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>sp_errors</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>position</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    azure_role_assignments [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>azure_role_assignments</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">role_name</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">scope_type</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">scope</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">subscription_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">subscription_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">management_group_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    group_memberships [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>group_memberships</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">membership_type</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">is_assignable_to_role</TD><TD ALIGN="LEFT">INTEGER (0/1)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">pim_membership</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    directory_roles [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>directory_roles</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">role_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">assignment_type</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">source_group_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">directory_scope_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">start_date_time</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">end_date_time</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    credentials [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>credentials</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">owner</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">credential_type</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">key_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">start_date_time</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">end_date_time</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    application_permissions [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>application_permissions</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">resource_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">resource_display_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">app_role_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">permission</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    delegated_permissions [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>delegated_permissions</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">resource_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">resource_display_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">scopes</TD><TD ALIGN="LEFT">TEXT NOT NULL (JSON)</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">consent_type</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">principal_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    owners [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#334155">
            <TR><TD BGCOLOR="#0369a1" COLSPAN="3"><FONT COLOR="white"><B>owners</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD PORT="sp_id" ALIGN="LEFT"><B>sp_id</B></TD><TD ALIGN="LEFT">INTEGER NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">owner</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">owner_type</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">principal_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
            <TR><TD></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    runs:id:e -> run_errors:run_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    runs:id:e -> service_principals:run_id:w [dir=both arrowtail=tee arrowhead="crowodot"];

    service_principals:id:e -> sp_sections:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> sp_errors:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> azure_role_assignments:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> group_memberships:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> directory_roles:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> credentials:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> application_permissions:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> delegated_permissions:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
    service_principals:id:e -> owners:sp_id:w [dir=both arrowtail=tee arrowhead="crowodot"];
}
